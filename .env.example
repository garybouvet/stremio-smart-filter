# Clé API TMDB (gratuite, themoviedb.org > Paramètres > API) : clé v3 ou jeton v4
TMDB_API_KEY=

# Addons Stremio servis par le moteur (voir README) : jeton secret dans l'adresse des addons
ADDON_TOKEN=
# Addon Langues : adresses manifest.json des addons de liens à regrouper, séparées par des espaces
LANGUES_SOURCES=
# Langue suivie (code à 2 lettres) et mode : trier (tout garder, langue d'abord) ou filtrer (retirer le reste)
LANGUES_LANG=fr
LANGUES_MODE=trier

# Notes Rotten Tomatoes, Metacritic, Letterboxd, Trakt (gratuit, mdblist.com > Preferences)
MDBLIST_API_KEY=

# Pause entre deux pages de catalogue d'addon (secondes) : plus longue chez les autres, ces addons sont tenus par des bénévoles
HARVEST_PAUSE=0.2
